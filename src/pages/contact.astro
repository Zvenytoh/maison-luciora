---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sun from '../components/decorative/Sun.astro';
---
<BaseLayout title="Contact" description="Écrivez à Maison Luciora pour une question sur une œuvre, une attention à offrir ou un projet à imaginer ensemble.">
  <section class="contact container" aria-labelledby="contact-title"><div class="contact-copy"><p class="label eyebrow">ENTRER EN CONVERSATION</p><h1 id="contact-title">Écrivons<br/><em>la suite.</em></h1><p class="contact-intro">Une œuvre vous parle.<br/>Une question vous accompagne.<br/>La Maison vous écoute.</p><div class="contact-links"><div><p class="label">NOUS ÉCRIRE</p><a class="contact-email" href="mailto:bonjour@maisonluciora.fr">bonjour@<wbr/>maisonluciora.fr <span aria-hidden="true">↗</span></a></div><div><p class="label">SUIVRE LA MAISON</p><a class="contact-instagram" href="https://www.instagram.com/maisonluciora/" target="_blank" rel="noreferrer">@maisonluciora <span aria-hidden="true">↗</span></a></div></div></div><div class="contact-symbol" aria-hidden="true"><Sun/><p class="label">DES SYMBOLES À GARDER.</p></div></section>
</BaseLayout>
<style>
  .contact { min-height: 92svh; display: grid; grid-template-columns: repeat(12,minmax(0,1fr)); gap: 28px; padding-top: 165px; padding-bottom: 115px; align-items: center; }
  .contact-copy { grid-column: 1/8; }
  h1 { font-size: clamp(85px,9.7vw,148px); line-height: .9; }
  h1 em { color: var(--gold-dark); }
  .contact-intro { font-size: 13px; line-height: 1.9; margin-top: 32px; }
  .contact-links { margin-top: 52px; display: grid; gap: 32px; }
  .contact-links .label { color: var(--gold-dark); margin-bottom: 10px; font-size: 9px; }
  .contact-email { font: 400 clamp(29px,3.1vw,48px)/1.3 var(--font-display); min-height: 44px; display: inline-block; }
  .contact-email span { font: 400 22px var(--font-ui); }
  .contact-instagram { font-size: 13px; min-height: 44px; display: inline-flex; align-items: center; gap: 24px; }
  .contact-links a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px; }
  .contact-symbol { grid-column: 9/13; text-align: center; color: var(--gold); }
  .contact-symbol :global(svg) { width: 100%; }
  .contact-symbol p { font-size: 8px; letter-spacing: .24em; color: var(--gold-dark); margin-top: 35px; }
  @media(max-width:767px) { .contact { display: block; padding-top: 145px; padding-bottom: 88px; } h1 { font-size: 100px; } .contact-intro { font-size: 12px; } .contact-email { font-size: clamp(30px,8.3vw,43px); } .contact-symbol { width: 160px; margin: 78px auto 0; } .contact-symbol p { margin-top: 25px; font-size: 7px; } }
</style>
