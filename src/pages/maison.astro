---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import emblem from '../assets/brand/maison-luciora.png';
import Divider from '../components/decorative/Divider.astro';
import { photography } from '../data/photography';
---
<BaseLayout title="La Maison" description="Maison Luciora imagine des objets symboliques, à la rencontre du tarot, de l’illustration et de l’objet décoratif. Découvrez l’intention de la Maison.">
  <section class="maison-hero container"><p class="label eyebrow">LA MAISON</p><h1>Une maison<br/><em>pour les symboles.</em></h1><p>Des histoires anciennes.<br/>Un regard d’aujourd’hui.</p></section>
  <section class="maison-story section container"><div class="maison-emblem" data-reveal><Image src={emblem} alt="Le soleil, la lune et les étoiles de l’emblème Maison Luciora, gravés en or sur papier ivoire." width={600} widths={[400,600,900]} sizes="(max-width:767px) 90vw, 45vw" format="webp" loading="lazy"/></div><div class="maison-story-copy" data-reveal><p class="label eyebrow">CE QUI NOUS ANIME</p><h2>La forme.<br/><em>Et ce qu’elle raconte.</em></h2><div class="prose"><p>Maison Luciora imagine des objets qui prennent place dans un intérieur autant par leur forme que par ce qu’ils représentent.</p><p>Le tarot est ici un répertoire de figures, de récits et de questions humaines. Nous y puisons des images pour parler du changement, du doute, du courage et de l’amour.</p><p>Chaque œuvre traduit un symbole ancien dans un langage graphique contemporain. Elle peut simplement être belle. Ou devenir personnelle.</p></div></div></section>
  <section class="maison-values section"><div class="container"><p class="label eyebrow" data-reveal>TROIS CONVICTIONS</p>{[
    ['01','La beauté d’abord.','Une ligne, une proportion, un espace. L’œuvre doit pouvoir être aimée avant même que l’on en connaisse l’histoire.'],
    ['02','Le symbole comme langage.','Nous ne cherchons pas à prédire l’avenir. Nous nous intéressons aux images qui nous aident à regarder le présent.'],
    ['03','Une place pour votre histoire.','L’intention d’une œuvre ne dicte pas sa signification. Ce que vous y voyez, ce qu’elle vous rappelle, lui donne une autre vie.']
  ].map(([number,title,text])=><div class="maison-value" data-reveal><span class="label">{number}</span><h3>{title}</h3><p>{text}</p></div>)}</div></section>
  <section class="maison-last section container"><div class="maison-still image-reveal" data-image-reveal><Image src={photography['gift']} alt="Papier ivoire, ruban doré et cadre en bois : les matières de l’univers Maison Luciora." width={1200} widths={[480,800,1200]} sizes="(max-width:767px) calc(100vw - 48px), 70vw" format="webp" loading="lazy"/></div><div class="maison-invitation" data-reveal><Divider/><h2>Choisir ce que l’on<br/><em>souhaite garder.</em></h2><a class="text-link" href="/collection/">Entrer dans la collection</a></div></section>
</BaseLayout>
<style>
  .maison-hero { padding-top: 175px; padding-bottom: 96px; }
  h1 { font-size: clamp(80px,8.8vw,135px); line-height: .96; }
  h1 em, h2 em { color: var(--gold-dark); }
  .maison-hero > p:last-child { font-size: 13px; line-height: 1.9; margin-top: 35px; margin-left: 50%; }
  .maison-story { border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(12,minmax(0,1fr)); gap: 32px; align-items: center; }
  .maison-emblem { grid-column: 1/7; }
  .maison-emblem :global(img) { mix-blend-mode: multiply; width: 100%; }
  .maison-story-copy { grid-column: 8/13; }
  .maison-story-copy h2 { font-size: clamp(48px,4.9vw,75px); line-height: 1.04; }
  .maison-story-copy .prose { font-size: 13px; line-height: 1.9; margin-top: 34px; }
  .maison-values { background: var(--paper-deep); }
  .maison-values .eyebrow { margin-bottom: 46px; }
  .maison-value { display: grid; grid-template-columns: 40px 1fr 370px; gap: 36px; padding: 42px 0; border-top: 1px solid var(--line); align-items: baseline; }
  .maison-value:last-child { border-bottom: 1px solid var(--line); }
  .maison-value .label { color: var(--gold-dark); }
  .maison-value h3 { font-size: clamp(32px,3.4vw,52px); }
  .maison-value > p { font-size: 12px; line-height: 1.9; }
  .maison-still { max-width: 1050px; margin-inline: auto; }
  .maison-still :global(img) { aspect-ratio: 1.6; object-fit: cover; }
  .maison-invitation { margin-top: 90px; text-align: center; }
  .maison-invitation h2 { margin-top: 45px; font-size: clamp(48px,5.4vw,82px); }
  .maison-invitation .text-link { margin-top: 28px; }
  @media(max-width:1024px) { .maison-value { grid-template-columns: 30px 1fr 280px; gap: 22px; } }
  @media(max-width:767px) { .maison-hero { padding-top: 143px; padding-bottom: 65px; } h1 { font-size: clamp(56px,14.5vw,90px); } .maison-hero > p:last-child { margin-left: 0; font-size: 12px; } .maison-story { display: block; padding-top: 65px; } .maison-emblem { margin-bottom: 43px; } .maison-story-copy h2 { font-size: clamp(46px,12vw,68px); } .maison-story-copy .prose { font-size: 12px; } .maison-value { grid-template-columns: 23px 1fr; gap: 14px; padding: 31px 0; } .maison-value h3 { font-size: 36px; } .maison-value > p { grid-column: 2; } .maison-still :global(img) { aspect-ratio: 1.15; } .maison-invitation { margin-top: 65px; } }
</style>
