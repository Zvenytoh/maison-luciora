---
import BaseLayout from '../layouts/BaseLayout.astro';
import Star from '../components/decorative/Star.astro';
---
<BaseLayout title="Arcane inconnu" description="Cette page semble avoir disparu du tirage. Retrouvez la collection Maison Luciora." noindex><section class="not-found section container"><Star type="eight"/><p class="label eyebrow">ARCANE INCONNU — 404</p><h1>Cette page semble<br/><em>avoir disparu du tirage.</em></h1><a class="text-link" href="/">Retour à la Maison</a></section></BaseLayout>
<style>.not-found { text-align: center; padding-top: 168px; }.not-found :global(svg) { width: 60px; margin: 0 auto 38px; color: var(--gold); }.not-found h1 { font-size: clamp(44px,6vw,90px); line-height:1.08; }.not-found .text-link { margin-top: 35px; }</style>
