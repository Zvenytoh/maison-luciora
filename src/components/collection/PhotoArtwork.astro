---
import { Image } from 'astro:assets';
import { photography } from '../../data/photography';
import FramedArtwork from './FramedArtwork.astro';
import type { Artwork } from '../../data/artworks';
interface Props { artwork: Artwork; class?: string; eager?: boolean; preview?: boolean; }
const { artwork, class: className = '', eager = false, preview = false } = Astro.props;
const photo = photography[artwork.slug];
---
{photo ? <Image class={className} src={photo} alt={`Cadre Maison Luciora ${artwork.name}, gravure dorée sur papier ivoire dans un cadre en bois sombre.`} widths={preview ? [176, 352] : [400, 640, 960, 1280]} sizes={preview ? '176px' : '(max-width: 767px) calc(100vw - 48px), (max-width: 1024px) 50vw, 620px'} width={preview ? 352 : 960} format="webp" quality={83} loading={eager || preview ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} /> : <FramedArtwork artwork={artwork} class={className}/>}
