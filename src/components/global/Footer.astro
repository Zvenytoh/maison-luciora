---
import Arrow from '../decorative/Arrow.astro';
import Sun from '../decorative/Sun.astro';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-intro"><Sun class="footer-sun"/><p class="label">DES SYMBOLES À GARDER.</p></div>
    <a class="footer-wordmark" href="/" title="Maison Luciora — accueil"><span>MAISON </span><span>LUCIORA</span></a>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} Maison Luciora</p>
      <nav aria-label="Navigation de pied de page"><a href="/collection/">Collection</a><a href="/maison/">La Maison</a><a href="/contact/">Contact</a><a href="https://www.instagram.com/maisonluciora/" target="_blank" rel="noreferrer">Instagram <Arrow/></a></nav>
      <p>FRANCE — MMXXVI</p>
    </div>
  </div>
</footer>
<style>
  .site-footer { padding-top: 96px; padding-bottom: 28px; border-top: 1px solid var(--line-light); }
  .footer-intro { text-align: center; display: grid; justify-items: center; gap: 28px; color: var(--gold-dark); }
  .footer-intro p { color: inherit; }
  :global(.footer-sun) { width: 82px; height: 82px; }
  .footer-wordmark { display: flex; flex-direction: column; align-items: center; color: var(--gold-dark); font-family: var(--font-display); margin: 54px 0 68px; line-height: .79; }
  .footer-wordmark span:first-child { font-size: clamp(18px,2.6vw,40px); letter-spacing: .4em; margin-bottom: 32px; padding-left: .4em; }
  .footer-wordmark span:last-child { font-size: clamp(74px,17.1vw,262px); letter-spacing: -.045em; }
  .footer-bottom { display: flex; justify-content: space-between; align-items: center; gap: 24px; border-top: 1px solid var(--line); padding-top: 22px; font-size: 10px; }
  .footer-bottom nav { display: flex; gap: 26px; flex-wrap: wrap; }
  .footer-bottom a { display: inline-flex; align-items: center; min-height: 44px; }
  .footer-bottom a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .footer-bottom p:last-child { font-size: 9px; letter-spacing: .12em; }
  @media(max-width:767px) { .site-footer { padding-top: 76px; } .footer-wordmark { margin: 40px 0; } .footer-wordmark span:first-child { margin-bottom: 22px; } .footer-bottom { flex-wrap: wrap; gap: 8px; } .footer-bottom nav { order: -1; width: 100%; justify-content: space-between; gap: 12px; } .footer-bottom p { font-size: 9px; } .footer-bottom p:last-child { margin-left: auto; } }
</style>
