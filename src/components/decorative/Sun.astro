    {rays.map((angle, i) => <path transform={`rotate(${angle} 120 120)`} d={i % 2 ? 'M116 76C110 58 126 40 120 10C127 41 121 59 124 76' : 'M117 76L120 0L123 76'} />)}
    <circle cx="120" cy="120" r="44"/><circle cx="120" cy="120" r="40"/>
