---
interface Props { direction?: 'up-right' | 'left' | 'right'; }
const { direction = 'up-right' } = Astro.props;
const rotation = { 'up-right': -45, left: 180, right: 0 }[direction];
---
<svg class="arrow-icon" width="1em" height="1em" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false" data-arrow={direction}>
  <path d="M4.5 12H19.5M13.5 6L19.5 12L13.5 18" transform={`rotate(${rotation} 12 12)`} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
<style>
  .arrow-icon { display: inline-block; width: 1em; height: 1em; flex-shrink: 0; vertical-align: -.12em; }
</style>
